{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": true,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "System Overview & Concurrency",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 5 }, { "color": "red", "value": 15 }] },
          "unit": "short"
        }
      },
      "gridPos": { "h": 5, "w": 4, "x": 0, "y": 1 },
      "id": 1,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Active In-Flight Sessions",
      "type": "stat",
      "targets": [{ "expr": "sum(langgraph_active_threads) or vector(0)", "legendFormat": "Active Sessions" }]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 2.0 }, { "color": "red", "value": 5.0 }] },
          "unit": "s"
        }
      },
      "gridPos": { "h": 5, "w": 4, "x": 4, "y": 1 },
      "id": 2,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Overall P95 Node Latency",
      "type": "stat",
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(langgraph_node_execution_seconds_bucket[5m])) by (le)) or vector(0)", "legendFormat": "P95 Latency" }]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 0.05 }] },
          "unit": "percentunit"
        }
      },
      "gridPos": { "h": 5, "w": 4, "x": 8, "y": 1 },
      "id": 3,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Overall Error Rate",
      "type": "stat",
      "targets": [{ "expr": "sum(rate(langgraph_node_errors_total[5m])) / (sum(rate(langgraph_node_execution_seconds_count[5m])) + 0.001)", "legendFormat": "Error Rate" }]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 15 }, { "color": "red", "value": 30 }] },
          "unit": "s"
        }
      },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 1 },
      "id": 14,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "P95 End-to-End Workflow Duration",
      "type": "stat",
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(langgraph_workflow_duration_seconds_bucket[5m])) by (le)) or vector(0)", "legendFormat": "Workflow Duration" }]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 10 }, { "color": "red", "value": 20 }] },
          "unit": "short"
        }
      },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 1 },
      "id": 15,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "P95 Agent Recursion Depth",
      "type": "stat",
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(langgraph_agent_loop_iterations_bucket[5m])) by (le)) or vector(0)", "legendFormat": "Turns / Session" }]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 },
      "id": 102,
      "title": "Model Cost & Token Intelligence",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth" },
          "unit": "currencyUSD"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 7 },
      "id": 7,
      "title": "Per-Model Cost Burn Rate ($ / Hour)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(langgraph_estimated_cost_usd_total{project_id=~\"$project_id\", model=~\"$model\"}[5m])) by (project_id, model, provider) * 3600",
          "legendFormat": "{{project_id}} / {{model}}"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "currencyUSD"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 7 },
      "id": 8,
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true
      },
      "title": "Cumulative Spend by Model ($ USD Total)",
      "type": "bargauge",
      "targets": [
        {
          "expr": "sum(langgraph_estimated_cost_usd_total{project_id=~\"$project_id\", model=~\"$model\"}) by (project_id, model)",
          "legendFormat": "{{project_id}} / {{model}}"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "fillOpacity": 20, "stacking": { "mode": "normal" } },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "id": 9,
      "title": "Token Consumption Velocity (Tokens / Minute)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(langgraph_llm_tokens_total{project_id=~\"$project_id\", model=~\"$model\"}[5m])) by (project_id, model, token_type) * 60",
          "legendFormat": "{{project_id}} / {{model}} ({{token_type}})"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "id": 10,
      "title": "Total Tokens Consumed per Model (Prompt vs Completion)",
      "type": "bargauge",
      "options": {
        "displayMode": "basic",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        {
          "expr": "sum(langgraph_llm_tokens_total{project_id=~\"$project_id\", model=~\"$model\"}) by (project_id, model, token_type)",
          "legendFormat": "{{project_id}} / {{model}} - {{token_type}}"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 },
      "id": 101,
      "title": "Multi-Agent Execution & LangSmith Traces",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "links": [
            {
              "title": "Inspect Node in LangSmith ➔",
              "url": "https://smith.langchain.com/o/default/projects/p/langgraph-observability-course?filter=tag:${__data.fields.node_name}",
              "targetBlank": true
            }
          ],
          "unit": "s"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "id": 5,
      "title": "Per-Node P95 Execution Latency (seconds) [Click to Trace]",
      "type": "timeseries",
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(langgraph_node_execution_seconds_bucket{node_name=~\"$node_name\"}[5m])) by (le, node_name))", "legendFormat": "{{node_name}}" }]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "links": [
            {
              "title": "Inspect Errors in LangSmith ➔",
              "url": "https://smith.langchain.com/o/default/projects/p/langgraph-observability-course?filter=tag:${__data.fields.node_name}",
              "targetBlank": true
            }
          ],
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "id": 6,
      "title": "Per-Node Error Invocations (errors/sec) [Click to Trace]",
      "type": "timeseries",
      "targets": [{ "expr": "sum(rate(langgraph_node_errors_total{node_name=~\"$node_name\"}[5m])) by (node_name, error_type)", "legendFormat": "{{node_name}} ({{error_type}})" }]
    },
    {
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "id": 13,
      "title": "Node Execution Latency Distribution (Heatmap)",
      "type": "heatmap",
      "targets": [
        {
          "expr": "sum(rate(langgraph_node_execution_seconds_bucket[5m])) by (le)",
          "format": "heatmap",
          "legendFormat": "{{le}}"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "id": 12,
      "title": "Tool Invocation Frequency",
      "type": "bargauge",
      "targets": [{ "expr": "sum(langgraph_tool_invocations_total) by (tool_name)", "legendFormat": "{{tool_name}}" }]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "style": "dark",
  "tags": ["langgraph", "langsmith", "llm-tracker", "sre"],
  "templating": {
    "list": [
      {
        "allValue": ".*",
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": "Prometheus",
        "definition": "label_values(langgraph_estimated_cost_usd_total, project_id)",
        "hide": 0,
        "includeAll": true,
        "label": "Project",
        "multi": true,
        "name": "project_id",
        "query": "label_values(langgraph_estimated_cost_usd_total, project_id)",
        "refresh": 1,
        "type": "query"
      },
      {
        "allValue": ".*",
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": "Prometheus",
        "definition": "label_values(langgraph_llm_tokens_total, model)",
        "hide": 0,
        "includeAll": true,
        "label": "Model",
        "multi": true,
        "name": "model",
        "query": "label_values(langgraph_llm_tokens_total, model)",
        "refresh": 1,
        "type": "query"
      },
      {
        "allValue": ".*",
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": "Prometheus",
        "definition": "label_values(langgraph_node_execution_seconds_bucket, node_name)",
        "hide": 0,
        "includeAll": true,
        "label": "Node",
        "multi": true,
        "name": "node_name",
        "query": "label_values(langgraph_node_execution_seconds_bucket, node_name)",
        "refresh": 1,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": { "refresh_intervals": ["5s", "10s", "30s", "1m"] },
  "timezone": "browser",
  "title": "Dashboard 1: LLM & Multi-Agent SRE Performance Tracker",
  "uid": "llm-agent-tracker",
  "version": 1
}
