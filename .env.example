# ==============================================================================
# LangGraph + LangSmith + Grafana Observability Configuration
# ==============================================================================

# --- LangSmith Distributed Tracing ---
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=lsv2_pt_your_langsmith_api_key_here
LANGCHAIN_PROJECT=langgraph-observability-course

# --- Project Identity & FinOps Cost Center ---
# Default active project if not explicitly passed by code
PROJECT_ID=course_learning

# --- Multi-Project Model Allowlists (Configured in the same .env) ---
# Format: PROJECT_<PROJECT_ID_UPPERCASE>_MODELS=model1,model2,...
# Format: PROJECT_<PROJECT_ID_UPPERCASE>_DEFAULT_MODEL=model1

# Course Learning Modules (OpenAI, Anthropic Claude, Google Gemini, Groq Llama)
PROJECT_COURSE_LEARNING_MODELS=openai/gpt-oss-120b,llama-3.3-70b-versatile,llama-3.1-8b-instant,gemini-1.5-flash,gemini-2.0-flash,gpt-4o-mini,claude-3-5-haiku-20241022,mock-model
PROJECT_COURSE_LEARNING_DEFAULT_MODEL=openai/gpt-oss-120b

# Project 1: E-Commerce Cart Recovery
PROJECT_ECOMMERCE_RECOVERY_MODELS=llama-3.3-70b-versatile,gemini-1.5-flash,gpt-4o-mini,mock-model
PROJECT_ECOMMERCE_RECOVERY_DEFAULT_MODEL=llama-3.3-70b-versatile

# Project 2: Customer Support Agent
PROJECT_CUSTOMER_SUPPORT_MODELS=claude-3-5-haiku-20241022,gpt-4o-mini,mock-model
PROJECT_CUSTOMER_SUPPORT_DEFAULT_MODEL=claude-3-5-haiku-20241022

# Global Fallback Allowlist (used if an unlisted project runs without its own PROJECT_<ID>_MODELS)
ALLOWED_MODELS=gemini-1.5-flash,gemini-2.0-flash,gpt-4o-mini,claude-3-5-haiku-20241022,mock-model

# --- Multi-Provider LLM Configuration ---
# Choose one of: openai | anthropic | google | groq
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0

# --- Provider API Keys (Fill the one you are using) ---
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=AIzaSy...
GROQ_API_KEY=gsk_...

# --- Prometheus & Monitoring ---
PROMETHEUS_PORT=8000
PROMETHEUS_METRICS_PATH=/metrics
